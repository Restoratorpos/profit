{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/react", "ultracite/next"],
  "javascript": {
    "globals": ["Liveblocks"]
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**/*",
      "!packages/design-system/components/ui",
      "!packages/design-system/lib",
      "!packages/design-system/hooks",
      "!packages/collaboration/config.ts",
      "!packages/cms/basehub-types.d.ts",
      // Generated by @tanstack/router-plugin from apps/web/src/routes on every
      // dev start and build. It is committed so a fresh clone typechecks before
      // anything is run, but it is not ours to format or lint.
      "!apps/web/src/routeTree.gen.ts"
    ]
  }
}
