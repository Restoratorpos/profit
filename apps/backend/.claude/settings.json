{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm --filter backend typecheck)",
      "Bash(pnpm --filter backend test)",
      "Bash(pnpm --filter backend test *)",
      "Bash(pnpm --filter backend build)",
      "Bash(pnpm --filter backend db:generate)",
      "Bash(pnpm install)",
      "Bash(pnpm install *)"
    ],
    "deny": [
      "Bash(pnpm --filter backend db:push*)",
      "Bash(*drizzle-kit push*)"
    ]
  }
}
